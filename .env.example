# .env.example — for notifier.py (the standalone WhatsApp reminder script)
#
# notifier.py runs as its own long-lived process, outside Streamlit, so it
# can't read .streamlit/secrets.toml. Copy this file to `.env` next to
# notifier.py and fill in real values, or export the same variables in
# your hosting provider's environment settings (Railway/Render/etc).

SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
